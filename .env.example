# Reference only. The application does NOT automatically load this file.
MG_PORT=8766
# Empty: Windows %LOCALAPPDATA%/MandateGuard/data, outside workspace/OneDrive.
# If overridden, use an absolute non-synchronized server directory.
MG_DATA_DIR=
# Optional invited sharing behind an HTTPS reverse proxy preserving the public Host.
# App still listens ONLY on 127.0.0.1. Empty origin keeps local-only mode.
MG_PUBLIC_ORIGIN=
# Set privately on the server, 24-256 characters. Never commit the actual code.
MG_INVITE_CODE=
# Required in invited mode; distinct private operator key, 24-256 characters.
# Protects operator endpoints. Demo operations additionally require the isolated
# execution runtime, captured account identity, approved policy and durable gates.
MG_OPERATOR_KEY=
MG_PLANNER=fixture
# Optional paid model route: MG_PLANNER=openai. Never enabled without explicit budget approval.
# Secret belongs only in the SERVER environment; never in frontend or committed files.
OPENAI_API_KEY=
MG_OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# Total call slots per database, including failed/timed-out attempts; persists across restart.
# Shared by OpenAI extraction/proposals and optional Ollama proposals.
# Workflow maximum: 3 total, including at most 1 extraction; global extraction cap: 40.
# The narrow text extractor is available only in openai mode; there is no fallback.
MG_OPENAI_CALL_LIMIT=100
# For an existing local Ollama installation: MG_PLANNER=ollama, plus model name.
# Free local preview: node scripts/start-local-model.mjs
# Read-only OKX + local model: node scripts/connect-okx-tr-local-model.mjs
# These launchers pin qwen3:4b-instruct and keep all order execution simulated.
MG_OLLAMA_MODEL=
MG_OLLAMA_URL=http://127.0.0.1:11434/api/chat
# ATK connection is opt-in and read-only by default.
# Use an installed Node.js executable and the actual installed MCP entry point.
MG_ATK_NODE=
MG_ATK_ENTRY=
MG_ATK_PROFILE=demo
# Optional isolated mode. Files contain nonsecret operator configuration.
MG_ATK_ISOLATED=0
MG_ATK_UPSTREAM_ENTRY=
# Optional exact-source bootstrap removes Windows-injected defaults before SDK imports.
MG_ATK_BOOTSTRAP_ENTRY=
MG_ATK_MANIFEST_FILE=
MG_ATK_CATALOG_APPROVAL_FILE=
MG_ATK_ACCOUNT_EXPECTATION_FILE=
# Explicit opt-in ONLY after runtime acceptance. Requires an exact execution
# derived entry, schema-v2 catalog approval, isolated demo credentials and operator key.
MG_ATK_EXECUTION=0
